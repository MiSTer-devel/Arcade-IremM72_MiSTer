`verilator_config

// Generated VHDL->Verilog netlists (yosys write_verilog output):
// overlapping casez arms carry priority semantics, benign.
lint_off -rule CASEOVERLAP -file "*/rtl_gen/*.v"
lint_off -rule CASEOVERLAP -file "rtl_gen/*.v"
lint_off -rule UNOPTFLAT   -file "*/rtl_gen/*.v"
lint_off -rule UNOPTFLAT   -file "rtl_gen/*.v"

// jt51 is third-party verilog
lint_off -file "*/jt51/*.v"

// Quartus accepts procedural assignment to implicit-wire outputs; the core
// RTL relies on that. Waive rather than touch synthesis sources.
lint_off -rule PROCASSWIRE

// sprite.sv declares block-local state inside always_ff with a power-on
// initialiser (`reg [3:0] st = 0;`) and then writes it with `<=`.  Verilator
// reads the initialiser as a blocking assignment and rejects the mix; it is a
// one-time static init, not a mixed-schedule write, so the pattern is safe.
// Waived rather than restructuring working synthesis RTL for the sim's benefit.
// NB: Verilator (as of 5.020) emits this as a hard %Error, not a waivable
// lint warning, so `lint_off` here has no effect - the actual suppression is
// the -Wno-BLKANDNBLK flag in the sim Makefile. Left in place as documentation.
lint_off -rule BLKANDNBLK -file "*/rtl/sprite.sv"
lint_off -rule BLKANDNBLK -file "*sprite.sv"

// By-design patterns in the core RTL:
lint_off -rule CASEX          // mcu.sv address decode uses casex intentionally
lint_off -rule MULTIDRIVEN    // dpramv true dual-port RAM writes from both ports
lint_off -rule PINMISSING     // unused ports intentionally left unconnected
lint_off -rule IMPLICITSTATIC // netlist/task statics, no functional impact
lint_off -rule REALCVT        // constant real->int conversions in params

// Make internal storage of the BRAM models public so the C++ harness can
// inspect/patch RAM contents directly (hex editors, DebugLink).
// nu8051 core keeps its 256B IRAM inside the core (nu8051_iram u_iram);
// expose its array for the MCU_RAM memory view.
public -module "nu8051_iram" -var "mem"
public -module "dpramv" -var "ram"
public -module "dpramv_cen" -var "ram"
public -module "dualport_ram_unreg" -var "ram"
public -module "dualport_ram_be" -var "ram"
public -module "singleport_ram" -var "ram"

// Sound command monitor (sim_sound_ui.cpp): the V30 -> Z80 latch strobes and
// the CPU write-data bus, so the harness can log every sound command byte the
// game sends without touching the synthesis RTL.
public -module "m72" -var "snd_latch1_wr"
public -module "m72" -var "snd_latch2_wr"
public -module "m72" -var "cpu_dout"

// Sound command injection and YM2151 write tracing (sim_sound_ui.cpp): the
// command latch the Z80 reads, and the YM2151 bus the driver drives.
public -module "sound" -var "snd_latch1"
public -module "sound" -var "snd_latch1_ready"
public -module "sound" -var "snd_latch2"
public -module "sound" -var "snd_latch2_ready"
public -module "sound" -var "SCS"
public -module "sound" -var "SWR_N"
public -module "sound" -var "SA0"
public -module "sound" -var "SD_IN"

// jt51 internals for the LFO/PM investigation (M72_JT51_LOG in
// sim_sound_ui.cpp): slot counter, per-slot phase and total attenuation, and
// the LFO's pitch/amplitude modulation outputs.
public -module "jt51" -var "cycles"
public -module "jt51" -var "ph_X"
public -module "jt51" -var "eg_XI"
public -module "jt51" -var "pm"
public -module "jt51" -var "am"

// jt51 envelope generator internals: the selected rate config, the effective
// rate after key scaling, the EG state and the raw (TL-free) envelope level.
public -module "jt51_eg" -var "cfg_III"
public -module "jt51_eg" -var "rate_V"
public -module "jt51_eg" -var "state_in_V"
public -module "jt51_eg" -var "eg_VII"
public -module "jt51_eg" -var "kshift_III"
public -module "jt51_eg" -var "sum_up"
public -module "jt51_eg" -var "step_VI"
public -module "jt51_eg" -var "cnt_V"
public -module "jt51_eg" -var "cnt_out"
public -module "jt51_eg" -var "eg_cnt"
